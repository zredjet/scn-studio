{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウとプレビューのウィンドウの権限",
  "windows": ["main", "preview"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-unminimize"
  ]
}
