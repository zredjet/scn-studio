==== game/scn/scn_defs.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

init -1 python:
    def _scn_div(a, b):
        q = abs(a) // abs(b)
        return q if (a < 0) == (b < 0) else -q

    if not hasattr(gui, "text_font"):
        config.screen_width = 1280
        config.screen_height = 720
        layout.defaults()
        style.menu_window.yalign = 0.45

init python:
    if renpy.loadable("SourceHanSansLite.ttf"):
        style.default.font = "SourceHanSansLite.ttf"

define akari = Character("灯", what_prefix="「", what_suffix="」")
define minato = Character("湊", what_prefix="「", what_suffix="」")
define miura = Character("三浦先生", what_prefix="「", what_suffix="」")
define tsumugi = Character("紬", what_prefix="「", what_suffix="」")
define akari_thought = Character("灯", kind=akari, what_prefix="『", what_suffix="』")

default flag_勇気 = 0
default flag_ルート = "共通"
default akari_好感度 = 0
default akari_転校済み = False
default tsumugi_好感度 = 0
default persistent.周回_トゥルー解放 = False

image bg ph_9ef9c0 = Composite((1280, 720), (0, 0), Solid("#30695e"), (40, 40), Text("背景：屋上/夕方（仮素材）", size=36))
