==== game/scn/story_chapter01.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

# s010 登校
label s010:
    scene bg ph_a16472
    # BGM 日常（ファイルが無いので鳴らさない）
    stop music
    "　坂道の途中で、後ろから鞄がぶつかってきた。"
    akari "おはよ、湊。今日も眠そうだね"
    minato "灯が元気すぎるんだよ"
    show akari ph_b605b6 at center
    akari "ひどいなあ。元気なのは、わたしの数少ない取り柄なのに"
    "　そう言って笑う顔に、昨日までと違うところは見つからなかった。"
    jump s011

# s011 昼休みの教室
label s011:
    scene bg ph_fe29c1
    show tsumugi ph_d913ac at right
    tsumugi "湊くん。灯ちゃん、最近なにか言ってた？"
    minato "なにかって？"
    tsumugi "……ううん、なんでもない"
    hide tsumugi
    # SE チャイム（ファイルが無いので鳴らさない）
    "　五限の予鈴が鳴った。机の中に、二つ折りのメモが入っていた。"
    "　{rb}放{/rb}{rt}﹅{/rt}{rb}課{/rb}{rt}﹅{/rt}{rb}後{/rb}{rt}﹅{/rt}{rb}、{/rb}{rt}﹅{/rt}{rb}屋{/rb}{rt}﹅{/rt}{rb}上{/rb}{rt}﹅{/rt}{rb}で{/rb}{rt}﹅{/rt}。丸い字は、灯のものだった。"
    menu:
        "屋上へ行くか"
        "すぐに行く":
            $ flag_勇気 += 1
            $ akari_好感度 += 2
        "少し迷ってから行く":
            $ akari_好感度 += 1
    jump s012

# s012 放課後の屋上
label s012:
    scene bg ph_9ef9c0 with fade
    # BGM 切ない（ファイルが無いので鳴らさない）
    stop music
    show akari ph_b605b6 at left
    # SE 風（ファイルが無いので鳴らさない）
    $ renpy.music.set_volume(0.6, channel="music")
    akari "やっと来た。遅いよ"
    "　風が強くて、灯の髪が{rb}乱{/rb}{rt}みだ{/rt}れていた。"
    akari "あのね、{w=0.5}話があるんだ"
    show akari ph_3734ec
    akari_thought "……やっぱり、言えないかも"
    menu:
        "どう答える"
        "「ごめん、遅くなって」":
            $ akari_好感度 += 1
        "黙ってうなずく" if (flag_勇気 >= 2):
            akari "……そういうところ、ずるいよね。昔からずっとそうだった。言わなくても分かってくれるって、私が勝手に思ってるだけなのに。だから今日も、言えないまま来ちゃった"
            jump s014
    if (akari_好感度 >= 3):
        akari "やっぱり、君には言っておく"
        jump s013a
    else:
        jump s013b

# s013a 打ち明ける
label s013a:
    show akari ph_3734ec at center
    stop music
    akari "わたし、夏休みが終わったら、転校するんだ"
    "　風の音だけが、しばらく続いた。"
    $ flag_ルート = "灯"
    jump s020

# s013b 帰り道
# AI下書き（status: ai-draft）
label s013b:
    scene bg ph_4dbc26
    # BGM 切ない（ファイルが無いので鳴らさない）
    stop music
    "　結局、灯は何も言わなかった。"
    "　校門を出たところで、見慣れた後ろ姿が待っていた。"
    show tsumugi ph_9ffd76 at center
    tsumugi "湊くん、一緒に帰ろ"
    $ tsumugi_好感度 += 1
    $ flag_ルート = "紬"
    jump s030

# s014 沈黙のあと
label s014:
    "（行き止まり：s014 沈黙のあと（スタブ））"
    $ renpy.full_restart()

==== game/scn/story_chapter02.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

# s020 灯の家の前
label s020:
    scene bg ph_8c9059
    "　灯の家の前に、段ボールが積まれていた。"
    akari "見られちゃったか"
    jump s021

# s021 屋上の約束
# AI下書き（status: ai-draft）
label s021:
    scene bg ph_6ef666
    show akari ph_abec96 at center
    akari "じゃあ約束。夏休みまで、毎日ここで"
    "　灯は髪留めに触れながら、小さく笑った。"
    jump s022

# s022 雨の図書室
label s022:
    jump s040

# s040 見送り
label s040:
    scene bg ph_fa78a2
    # BGM 切ない（ファイルが無いので鳴らさない）
    stop music
    akari "またね、湊。" (what_suffix="")
    akari "……またね{w=1}" (what_prefix="")
    $ akari_転校済み = True
    # エンディング akari_end
    $ renpy.full_restart()

