==== game/scn/scn_defs.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

init -1 python:
    def _scn_div(a, b):
        q = abs(a) // abs(b)
        return q if (a < 0) == (b < 0) else -q

    if not hasattr(gui, "text_font"):
        config.screen_width = 1280
        config.screen_height = 720
        layout.defaults()
        style.menu_window.yalign = 0.45

init python:
    if renpy.loadable("SourceHanSansLite.ttf"):
        style.default.font = "SourceHanSansLite.ttf"

define haruto = Character("遥人", what_prefix="「", what_suffix="」")
define saeki = Character("佐伯", what_prefix="「", what_suffix="」")
define shino = Character("志乃", what_prefix="「", what_suffix="」")
define haruto_thought = Character("遥人", kind=haruto, what_prefix="『", what_suffix="』")
define shino_name = Character("少女", kind=shino, what_prefix="「", what_suffix="」")

default flag_話した = False
default shino_信頼 = 0
default flag_傘 = False
default flag_残る = False

image bg ph_18cec1 = Composite((1280, 720), (0, 0), Solid("#313e58"), (40, 40), Text("背景：バス停/朝（仮素材）", size=36))
image bg ph_beac49 = Composite((1280, 720), (0, 0), Solid("#395c7e"), (40, 40), Text("背景：待合室/夜（仮素材）", size=36))
image bg ph_bdbd26 = Composite((1280, 720), (0, 0), Solid("#566d7d"), (40, 40), Text("背景：待合室/夜明け（仮素材）", size=36))
image bg ph_9661ec = Composite((1280, 720), (0, 0), Solid("#5c5156"), (40, 40), Text("背景：駅/夜（仮素材）", size=36))
image saeki ph_959685 = Composite((384, 612), (0, 0), Solid("#5c3c52"), (12, 12), Text("佐伯：笑顔（仮素材）", size=28))
image shino ph_2fa07b = Composite((384, 612), (0, 0), Solid("#3a6654"), (12, 12), Text("志乃：伏し目（仮素材）", size=28))
image shino ph_94a055 = Composite((384, 612), (0, 0), Solid("#3a6654"), (12, 12), Text("志乃：真顔（仮素材）", size=28))
image shino ph_8555df = Composite((384, 612), (0, 0), Solid("#3a6654"), (12, 12), Text("志乃：笑顔（仮素材）", size=28))
