==== game/scn/story_chapter01.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

# s01 改札前
# AI下書き（status: ai-draft）
label s01:
    scene bg ph_9661ec
    # BGM 雨音（ファイルが無いので鳴らさない）
    stop music
    # SE 雷（ファイルが無いので鳴らさない）
    "　雨は、駅舎のトタン屋根を休みなく叩いていた。"
    "　改札の上の電光板から、最終列車の文字が消える。"
    call s90
    haruto_thought "……歩いて帰れる距離じゃないな"
    "　ポケットの中の小銭を数えてから、遥人は待合室のドアを押した。"
    # SE ドア（ファイルが無いので鳴らさない）
    jump s02

# s02 待合室
# AI下書き（status: ai-draft）
label s02:
    scene bg ph_beac49 with fade
    show shino ph_2fa07b at right
    "　ストーブの消えた待合室に、先客が一人いた。"
    "　同じくらいの年の少女が、膝の上に大きな旅行鞄を抱えている。"
    "　鞄には、隣の県の住所が書かれた札が下がっていた。"
    menu:
        "どうする"
        "話しかける":
            $ flag_話した = True
            jump s03
        "本を開く":
            jump s04

# s03 鞄の理由
# AI下書き（status: ai-draft）
label s03:
    show shino ph_94a055 at right
    haruto "……列車、止まっちゃいましたね"
    shino_name "はい。{w=0.5}バスは、朝まで来ないそうです"
    haruto "朝まで"
    shino_name "始発で、ここを出るんです。わたし、志乃といいます"
    "　名前を言うときだけ、少女は遥人の顔を見た。"
    shino "親戚の家に行くんです。……荷物、多すぎますよね"
    haruto "多すぎる、かな"
    "　志乃は、少しだけ笑った。"
    show shino ph_8555df at right
    $ shino_信頼 += 1
    jump s05

# s04 本と雨音
# AI下書き（status: ai-draft）
label s04:
    "　遥人は鞄から文庫本を出した。"
    "　ページをめくる音と、雨の音だけが続く。"
    "　少女は、ずっと窓の外を見ていた。"
    "　窓ガラスの向こうでは、街灯の光が雨に{rb}ほ{/rb}{rt}﹅{/rt}{rb}ど{/rb}{rt}﹅{/rt}{rb}け{/rb}{rt}﹅{/rt}{rb}て{/rb}{rt}﹅{/rt}いる。"
    jump s05

# s05 見回り
# AI下書き（status: ai-draft）
label s05:
    show saeki ph_959685 at left
    # SE ドア（ファイルが無いので鳴らさない）
    saeki "いやあ、ひどい雨だなあ。毛布、二枚しかないけど使っておくれ"
    call s90
    saeki "始発のバスは五時四十分。それまではここで辛抱だなあ"
    if flag_話した:
        saeki "ふたり、知り合いだったのかい。そりゃよかったなあ"
    else:
        saeki "ふたりとも、黙りこくって。風邪ひくなよう"
    hide saeki
    jump s06

# s06 雨脚
# AI下書き（status: ai-draft）
label s06:
    # SE 雷（ファイルが無いので鳴らさない）
    with Fade(0.2, 0.6, 0.4)
    pause 1
    "　一度だけ、空が白く光った。"
    "　蛍光灯が消え、待合室は雨の音でいっぱいになった。"
    if flag_話した:
        shino "……{nw}" (what_suffix="")
        # SE 雷（ファイルが無いので鳴らさない）
        extend "こわくないです。こわくないけど" (what_prefix="「", what_suffix="」")
    else:
        shino_name "……{nw}" (what_suffix="")
        # SE 雷（ファイルが無いので鳴らさない）
        extend "こわくないです。こわくないけど" (what_prefix="「", what_suffix="」")
    "　暗がりの向こうで、鞄の留め金が鳴った。"
    menu:
        "暗がりで"
        "傘を差し出す":
            $ flag_傘 = True
            $ shino_信頼 += 1
            haruto "朝、これ使って。バス停まで濡れるから"
            jump s07
        "黙って待つ":
            jump s07
        "「行かなくていいんじゃないか」" if (shino_信頼 >= 1):
            $ flag_残る = True
            $ shino_信頼 += 1
            shino "……そんなこと、初めて言われました"
            jump s07

==== game/scn/story_chapter02.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

# s07 夜明け前
# AI下書き（status: ai-draft）
label s07:
    scene bg ph_bdbd26 with fade
    # BGM 夜明け（ファイルが無いので鳴らさない）
    stop music
    "　蛍光灯がまたたいて、点いた。"
    "　窓の外が、少しずつ灰色になっていく。"
    if flag_残る:
        jump s10
    elif (shino_信頼 >= 1):
        jump s08
    else:
        jump s11

# s08 始発バス
# AI下書き（status: ai-draft）
label s08:
    scene bg ph_18cec1 with fade
    show shino ph_94a055 at center
    if (not flag_話した):
        shino_name "……わたし、志乃といいます。傘、ありがとうございました"
        $ flag_話した = True
    "　雨は、霧のような細さになっていた。"
    if flag_傘:
        "　志乃は、遥人の傘を差していた。"
    else:
        "　志乃は、鞄を頭の上にかざしていた。"
    shino "見送りは、いらないって思ってたんです"
    haruto "……うん"
    shino "でも、いてくれて、よかったです"
    jump s09

# s09 約束
# AI下書き（status: ai-draft）
label s09:
    # SE バス（ファイルが無いので鳴らさない）
    show shino ph_8555df at center
    if flag_傘:
        shino "この傘、いつか返しに来ます。" (what_suffix="")
        shino "この駅に" (what_prefix="")
    else:
        shino "いつか、また。" (what_suffix="")
        shino "この駅で" (what_prefix="")
    hide shino with fade
    "　バスの赤い灯が、坂の向こうに消えた。"
    # エンディング bus_end
    $ renpy.full_restart()

# s10 もう一日
# AI下書き（status: ai-draft）
label s10:
    show shino ph_8555df at center
    shino "始発、一本だけ遅らせます。{w=1}親戚には、電話しておきます"
    haruto "一本だけ"
    shino "はい。……一日だけ、です"
    "　鞄は、待合室の椅子の上に置かれたままだった。"
    # エンディング stay_end
    $ renpy.full_restart()

# s11 雨上がり
# AI下書き（status: ai-draft）
label s11:
    stop music
    "　雨が上がった。"
    "　少女は鞄を抱えてバス停へ、遥人は始発列車のホームへ。"
    "　名前も知らないまま、待合室のドアが閉まった。"
    # SE ドア（ファイルが無いので鳴らさない）
    # エンディング rain_end
    $ renpy.full_restart()

# s90 構内放送
# AI下書き（status: ai-draft）
label s90:
    "　スピーカーが、ざらついた声で告げた。"
    "　――大雨のため、本日の列車はすべて運転を見合わせます。始発バスは、五時四十分の予定です。"
    return

