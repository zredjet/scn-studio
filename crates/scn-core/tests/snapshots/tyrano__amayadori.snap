==== data/scenario/scn/scn_start.ks
; scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。
; 準備（メッセージ枠と名前の欄）、定義（キャラクターと変数）と、開始シーンへのジャンプ。first.ks か title.ks から [jump storage="scn/scn_start.ks"] で始める。

*start
[clearstack]
[cm]
[chara_hide_all time="0"]
[stopbgm]
; メッセージ枠と名前の欄（プロファイルの setup で変える）
[layopt layer="message0" visible="true"]
[position layer="message0" left="160" top="496" width="960" height="194" page="fore" visible="true"]
[position layer="message0" page="fore" margint="45" marginl="50" marginr="70" marginb="60"]
[free name="chara_name_area" layer="message0"]
[ptext name="chara_name_area" layer="message0" color="white" size="28" bold="true" x="180" y="506"]
[chara_config ptext="chara_name_area"]
[chara_new name="saeki" storage="scn/ph_959685.svg" jname="佐伯"]
[chara_face name="saeki" face="f_7389e9" storage="scn/ph_959685.svg"]
[chara_new name="shino" storage="scn/ph_2fa07b.svg" jname="志乃"]
[chara_face name="shino" face="f_ff111d" storage="scn/ph_2fa07b.svg"]
[chara_face name="shino" face="f_74da1b" storage="scn/ph_94a055.svg"]
[chara_face name="shino" face="f_7389e9" storage="scn/ph_8555df.svg"]
[eval exp="f['flag.話した'] = false"]
[eval exp="f['shino.信頼'] = 0"]
[eval exp="f['flag.傘'] = false"]
[eval exp="f['flag.残る'] = false"]
[jump storage="scn/story_chapter01.ks" target="*s01"]
