==== game/scn/scn_defs.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

init -1 python:
    def _scn_div(a, b):
        q = abs(a) // abs(b)
        return q if (a < 0) == (b < 0) else -q

    if not hasattr(gui, "text_font"):
        config.screen_width = 1280
        config.screen_height = 720
        layout.defaults()
        style.menu_window.yalign = 0.45

init python:
    if renpy.loadable("scn/fonts/my.ttf"):
        style.default.font = "scn/fonts/my.ttf"

define akari = Character("灯", what_prefix="「", what_suffix="」")

image bg ph_f685ee = Composite((1280, 720), (0, 0), Solid("#5e3576"), (40, 40), Text("背景：外（仮素材）", size=36))
image bg room = "scn/files/bg/room.png"
image akari ph_1554b9 = Composite((384, 612), (0, 0), Solid("#595069"), (12, 12), Text("灯：泣き（仮素材）", size=28))
image akari smile = "scn/files/chara/akari/smile.png"
