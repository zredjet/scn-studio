==== game/scn/story_a.rpy
# scn-studio が .scn から書き出したファイル。手で直さない（書き出すたびに作り直す）。

# s1 a
label s1:
    scene bg room with fade
    scene bg ph_f685ee with dissolve
    show akari smile at left
    show akari ph_1554b9
    play music "scn/files/bgm/theme.ogg" noloop
    # SE ドア（ファイルが無いので鳴らさない）
    voice "scn/voice/akari_k3f9.ogg"
    akari "声" (what_suffix="")
    voice sustain
    akari "続き{nw}" (what_prefix="", what_suffix="")
    # SE ドア（ファイルが無いので鳴らさない）
    voice sustain
    extend "おわり" (what_prefix="", what_suffix="」")
    akari "無声"
    hide akari
    stop music
    # エンディング e
    $ renpy.full_restart()

